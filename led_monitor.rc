service led_monitor /system/bin/sh /vendor/etc/init/led_startup.sh
    class main
    user root
    group root system
    # seclabel u:r:su:s0 существует на userdebug-прошивках (наш парк):
    # домен permissive даже при enforcing SELinux. На user-прошивках
    # этой строки не было бы — сервис не стартовал бы без su-домена.
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start led_monitor
