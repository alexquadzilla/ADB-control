# led_monitor.rc v2 — регистрация автозапуска led_startup.sh в init
# seclabel не задаём: на userdebug-прошивках с permissive SELinux
# (наш случай) сервис стартует в домене init и этого достаточно;
# u:r:su:s0 работал бы тоже, но привязывал бы сервис к домену su.
service led_monitor /system/bin/sh /vendor/etc/init/led_startup.sh
    class main
    user root
    group root system
    disabled

on property:sys.boot_completed=1
    start led_monitor
